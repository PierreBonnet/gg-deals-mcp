{
  "name": "gg-deals-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for the official GG.deals Prices API",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "PierreBonnet",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gg-deals-mcp": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PierreBonnet/gg-deals-mcp.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
